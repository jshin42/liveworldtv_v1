# Production Environment Variables Template
# Copy this to .env.production and update with your actual domain

# Database (Production - use managed service)
DATABASE_URL=postgresql://user:password@host:5432/liveworldtv_prod

# Redis (Production)
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password

# Server
PORT=3001
NODE_ENV=production

# CORS Configuration (Production)
# Update with your actual frontend domain(s)
# Examples:
#   For DubWorld.tv: https://dubworld.tv,https://www.dubworld.tv
#   For LiveWorld.tv: https://liveworld.tv,https://www.liveworld.tv
#   Multiple domains: https://dubworld.tv,https://liveworld.tv
CORS_ORIGIN=https://yourdomain.tv,https://www.yourdomain.tv
CORS_CREDENTIALS=true

# API Keys
YOUTUBE_API_KEY=your-youtube-api-key-here
