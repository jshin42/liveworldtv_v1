# LiveWorldTV API - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=development  # development | staging | production
PORT=3001

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL Database URL
# Format: postgresql://username:password@hostname:port/database
#
# Development (Local):
DATABASE_URL=postgresql://liveworldtv:liveworldtv@localhost:5432/liveworldtv

# Production Options:
# - Neon (Free): Get from https://neon.tech
#   DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/liveworldtv?sslmode=require
#
# - Supabase: Get from https://supabase.com
#   DATABASE_URL=postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#
# - Railway: Provisioned automatically when you add PostgreSQL service
#   DATABASE_URL=${{Postgres.DATABASE_URL}}

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis URL for caching
# Format: redis://[username:password@]hostname:port[/database]
#
# Development (Local):
REDIS_URL=redis://localhost:6379

# Production Options:
# - Upstash (Free): Get from https://upstash.com
#   REDIS_URL=redis://default:pass@us1-xxx.upstash.io:6379
#
# - Railway: Provisioned automatically when you add Redis service
#   REDIS_URL=${{Redis.REDIS_URL}}

# ============================================================================
# CORS Configuration
# ============================================================================

# Comma-separated list of allowed origins
# Development:
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Production:
# CORS_ORIGINS=https://liveworldtv.vercel.app,https://www.liveworldtv.com

# ============================================================================
# Feature Flags
# ============================================================================

# Enable/disable features
ENABLE_DUBBING=true
ENABLE_ANALYTICS=true
ENABLE_DISCOVERY=false
ENABLE_CACHING=true

# ============================================================================
# External APIs (Optional)
# ============================================================================

# YouTube Data API (for channel metadata)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# 7pm.com scraping (if implemented)
# SCRAPER_USER_AGENT=LiveWorldTV/1.0 (+https://liveworldtv.com/bot)

# ============================================================================
# Monitoring & Observability (Optional)
# ============================================================================

# Sentry for error tracking
# Get from: https://sentry.io
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Datadog APM (Tier 3 only)
# Get from: https://datadoghq.com
# DD_API_KEY=your_datadog_api_key
# DD_SERVICE=liveworldtv-api
# DD_ENV=production

# Logtail/BetterStack logging
# Get from: https://betterstack.com
# LOGTAIL_SOURCE_TOKEN=your_logtail_token

# ============================================================================
# Security
# ============================================================================

# JWT Secret for session tokens (generate with: openssl rand -hex 32)
# JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=60000  # 1 minute
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# ============================================================================
# Performance Tuning
# ============================================================================

# Database connection pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis connection pool
REDIS_POOL_MIN=2
REDIS_POOL_MAX=10

# Cache TTL (seconds)
CACHE_TTL_CHANNELS=300       # 5 minutes
CACHE_TTL_STREAMS=60         # 1 minute
CACHE_TTL_RANKINGS=180       # 3 minutes

# ============================================================================
# Development Tools
# ============================================================================

# Enable debug logging
DEBUG=false

# Enable query logging
LOG_SQL_QUERIES=false

# Enable performance profiling
ENABLE_PROFILING=false
