# Production Environment Variables Template
# Copy this to .env.production and update with your actual domain

# API Configuration
# Example: https://api.dubworld.tv or https://api.liveworld.tv
NEXT_PUBLIC_API_URL=https://api.yourdomain.tv

# Site Configuration
# Example: https://dubworld.tv or https://liveworld.tv
NEXT_PUBLIC_SITE_URL=https://yourdomain.tv
NEXT_PUBLIC_SITE_NAME=LiveWorldTV

# Feature Flags
NEXT_PUBLIC_ENABLE_DUBBING=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Analytics (Production)
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.tv
