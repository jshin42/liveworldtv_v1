# LiveWorldTV Web Frontend - Environment Variables
# Copy this file to .env.local and fill in your actual values
#
# Note: All environment variables for Next.js must be prefixed with NEXT_PUBLIC_
# to be exposed to the browser

# ============================================================================
# API Configuration
# ============================================================================

# Backend API URL
# Development (Local):
NEXT_PUBLIC_API_URL=http://localhost:3001

# Production Options:
# - Railway:
#   NEXT_PUBLIC_API_URL=https://liveworldtv-api.railway.app
#
# - Custom domain:
#   NEXT_PUBLIC_API_URL=https://api.liveworldtv.com
#
# - Render:
#   NEXT_PUBLIC_API_URL=https://liveworldtv-api.onrender.com

# ============================================================================
# Feature Flags
# ============================================================================

# Enable AI dubbing features in UI
NEXT_PUBLIC_ENABLE_DUBBING=true

# Enable analytics tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Show debug information in development
NEXT_PUBLIC_DEBUG_MODE=false

# Enable extension installation prompt
NEXT_PUBLIC_SHOW_EXTENSION_PROMPT=true

# ============================================================================
# Application Configuration
# ============================================================================

# Application environment
NEXT_PUBLIC_ENV=development  # development | staging | production

# Application version (automatically set by CI/CD in production)
NEXT_PUBLIC_APP_VERSION=0.1.0

# Application name
NEXT_PUBLIC_APP_NAME=LiveWorldTV

# ============================================================================
# External Services (Optional)
# ============================================================================

# Google Analytics 4
# Get from: https://analytics.google.com
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry for error tracking (frontend)
# Get from: https://sentry.io
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# PostHog for analytics
# Get from: https://posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Vercel Analytics
# Automatically enabled when deployed to Vercel
# No configuration needed

# ============================================================================
# Performance Configuration
# ============================================================================

# API request timeout (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=10000

# Number of retries for failed API requests
NEXT_PUBLIC_API_RETRIES=2

# Enable service worker for offline support (future feature)
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=false

# ============================================================================
# Content Configuration
# ============================================================================

# Default country for channel listings
NEXT_PUBLIC_DEFAULT_COUNTRY=US

# Default topic filter
NEXT_PUBLIC_DEFAULT_TOPIC=NEWS

# Maximum channels to display in sidebar
NEXT_PUBLIC_MAX_SIDEBAR_CHANNELS=20

# Enable auto-play on page load
NEXT_PUBLIC_AUTO_PLAY=true

# ============================================================================
# Extension Configuration
# ============================================================================

# Chrome Extension ID (set after publishing to Chrome Web Store)
# NEXT_PUBLIC_EXTENSION_ID=abcdefghijklmnopqrstuvwxyz123456

# Extension download URL
# NEXT_PUBLIC_EXTENSION_URL=https://chrome.google.com/webstore/detail/liveworldtv/xxxxx

# Minimum supported extension version
# NEXT_PUBLIC_MIN_EXTENSION_VERSION=0.1.0

# ============================================================================
# Development Tools
# ============================================================================

# Show React Query DevTools
NEXT_PUBLIC_SHOW_DEVTOOLS=false

# Enable verbose logging
NEXT_PUBLIC_VERBOSE_LOGGING=false

# Mock API responses (for testing without backend)
NEXT_PUBLIC_MOCK_API=false
