{
  "name": "@liveworldtv/extension",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production && cp manifest.json dist/ && cp -r icons dist/ && cp src/popup/popup.html dist/popup/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node ../../tools/scripts/package-extension.js",
    "install-dev": "node ../../tools/scripts/install-extension.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@liveworldtv/ai-models": "*",
    "@liveworldtv/shared-types": "*",
    "@liveworldtv/telemetry": "*",
    "onnxruntime-web": "^1.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@types/chrome": "^0.0.276",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^12.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-loader": "^9.5.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.0"
  }
}
