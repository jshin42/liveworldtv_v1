{
  "manifest_version": 3,
  "name": "LiveWorldTV Dubbing",
  "version": "0.1.0",
  "description": "Real-time AI dubbing for global live TV. Experience any country's news and entertainment in English.",
  
  "permissions": [
    "tabCapture",
    "storage",
    "offscreen"
  ],
  
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.twitch.tv/*",
    "*://*.dailymotion.com/*",
    "*://*.vimeo.com/*",
    "http://localhost:3001/*"
  ],
  
  "background": {
    "service_worker": "dist/background/background.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["dist/content/youtube-content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.twitch.tv/*",
        "*://*.dailymotion.com/*",
        "*://*.vimeo.com/*"
      ],
      "js": ["dist/content/content-script.js"],
      "run_at": "document_idle", 
      "all_frames": false
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": [
        "models/*.onnx",
        "workers/*.js",
        "offscreen.html"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.twitch.tv/*",
        "*://*.dailymotion.com/*",
        "*://*.vimeo.com/*"
      ]
    }
  ],
  
  "action": {
    "default_popup": "dist/popup/popup.html",
    "default_title": "LiveWorldTV Dubbing"
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}